EXPO_PUBLIC_API_BASE_URL=http://10.0.2.2:8000/api
# Android emulator address above. For a physical phone, replace it with:
# EXPO_PUBLIC_API_BASE_URL=http://<computer-Wi-Fi-IPv4>:8000/api
# Start backend with: composer serve:lan
# Keep phone/computer on the same Wi-Fi and fully reload Expo after changes.
ISLASAFE_BUILD=development
# Google Cloud OAuth client IDs (public identifiers, not client secrets).
EXPO_PUBLIC_GOOGLE_WEB_CLIENT_ID=
EXPO_PUBLIC_GOOGLE_IOS_CLIENT_ID=
# Reversed iOS client ID, e.g. com.googleusercontent.apps.<ios-client-prefix>.
GOOGLE_IOS_URL_SCHEME=
