EXPO_PUBLIC_API_BASE_URL=
# Leave blank to share Metro's connection on phones and emulators.
# Start backend with: php artisan serve --host=127.0.0.1 --port=8000
ISLASAFE_API_UPSTREAM=http://127.0.0.1:8000
# To use a hosted API instead, set EXPO_PUBLIC_API_BASE_URL=https://<host>/api.
# Keep phone/computer on the same Wi-Fi and reopen Expo after changes.
ISLASAFE_BUILD=development
